[Unit]
Description=Protobot collaboration room
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=protobot
Group=protobot
WorkingDirectory=/var/lib/protobot-collab
ExecStart=/opt/protobot-collab/protobot-collab serve --data-dir /var/lib/protobot-collab/team --listen http://127.0.0.1:8787
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/protobot-collab
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
